{
  "name": "CreditPurchase",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Authenticated user who initiated the purchase"
    },
    "paypal_order_id": {
      "type": "string",
      "description": "PayPal order id (unique per purchase)"
    },
    "pack": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "description": "Server-authoritative credit pack key"
    },
    "expected_amount": {
      "type": "string",
      "description": "Expected charge amount in USD (server-determined)"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "credits_to_grant": {
      "type": "number",
      "description": "Number of credits to grant on successful capture (server-determined)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "captured",
        "failed"
      ],
      "default": "pending",
      "description": "Lifecycle state of the purchase"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "paypal_order_id",
    "pack",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}