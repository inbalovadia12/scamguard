{
  "name": "ProtectedSenior",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Senior's display name"
    },
    "email": {
      "type": "string",
      "description": "Senior's email for their account"
    },
    "phone": {
      "type": "string",
      "description": "Senior's phone number for quick call & text actions from alerts"
    },
    "guardian_id": {
      "type": "string",
      "description": "User ID of the guardian/family member"
    },
    "guardian_email": {
      "type": "string",
      "description": "Guardian's email for alert notifications"
    },
    "guardian_name": {
      "type": "string",
      "description": "Guardian's display name"
    },
    "guardian_plan": {
      "type": "string",
      "enum": [
        "starter",
        "plus",
        "premium"
      ],
      "description": "The guardian's current plan, propagated so the senior inherits the same perks"
    },
    "consent_given": {
      "type": "boolean",
      "default": false,
      "description": "Whether the senior has given consent for monitoring"
    },
    "alert_preference": {
      "type": "string",
      "enum": [
        "all",
        "high_risk_only",
        "financial_only"
      ],
      "default": "all",
      "description": "What types of alerts the guardian receives"
    },
    "incognito_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the guardian allows this senior to use Incognito Search (private scans with no history or alerts)"
    },
    "protection_settings": {
      "type": "object",
      "description": "Per-member protection toggles and level",
      "properties": {
        "link_protection": {
          "type": "boolean",
          "default": true
        },
        "message_protection": {
          "type": "boolean",
          "default": true
        },
        "image_scanning": {
          "type": "boolean",
          "default": true
        },
        "qr_scanning": {
          "type": "boolean",
          "default": true
        },
        "email_protection": {
          "type": "boolean",
          "default": true
        },
        "call_protection": {
          "type": "boolean",
          "default": true
        },
        "ask_family": {
          "type": "boolean",
          "default": true
        },
        "guardian_notifications": {
          "type": "boolean",
          "default": true
        },
        "protection_level": {
          "type": "string",
          "enum": [
            "basic",
            "standard",
            "maximum"
          ],
          "default": "standard"
        }
      }
    },
    "senior_user_id": {
      "type": "string",
      "description": "The senior's user ID once they create an account"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for this record"
    }
  },
  "required": [
    "name",
    "guardian_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.guardian_id": "{{user.id}}"
        },
        {
          "data.senior_user_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.guardian_id": "{{user.id}}"
        },
        {
          "data.senior_user_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.guardian_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}