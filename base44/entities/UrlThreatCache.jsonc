{
  "name": "UrlThreatCache",
  "type": "object",
  "properties": {
    "normalized_url": {
      "type": "string",
      "description": "Canonical URL used as the cache key"
    },
    "virustotal": {
      "type": "object",
      "description": "Cached VirusTotal URL reputation result"
    },
    "urlhaus": {
      "type": "object",
      "description": "Cached URLhaus URL reputation result"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When threat intelligence was last checked"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cached threat-intelligence result expires"
    }
  },
  "required": [
    "normalized_url",
    "checked_at",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}