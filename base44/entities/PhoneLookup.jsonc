{
  "name": "PhoneLookup",
  "type": "object",
  "properties": {
    "phone_number": {
      "type": "string",
      "description": "The phone number looked up"
    },
    "country": {
      "type": "string",
      "description": "Country where the number is registered"
    },
    "carrier": {
      "type": "string",
      "description": "Telecom carrier/provider"
    },
    "reputation_score": {
      "type": "number",
      "description": "0-100 scam risk score, 100 = definitely a scam"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Risk level"
    },
    "user_reports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User reports about this number"
    },
    "scam_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types of scams associated with this number"
    },
    "summary": {
      "type": "string",
      "description": "Overall assessment"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs where information was found"
    },
    "report_count": {
      "type": "number",
      "default": 0,
      "description": "Total community + web reports"
    },
    "scam_report_count": {
      "type": "number",
      "default": 0,
      "description": "Reports classifying this number as a scam"
    },
    "spam_report_count": {
      "type": "number",
      "default": 0,
      "description": "Reports classifying this number as spam/telemarketing"
    },
    "suspicious_report_count": {
      "type": "number",
      "default": 0,
      "description": "Reports flagging this number as suspicious"
    },
    "safe_report_count": {
      "type": "number",
      "default": 0,
      "description": "Reports confirming this number is safe"
    },
    "caller_id_status": {
      "type": "string",
      "enum": [
        "SCAM",
        "SPAM",
        "SUSPICIOUS",
        "SAFE",
        "UNKNOWN"
      ],
      "default": "UNKNOWN",
      "description": "Vardin's caller-ID classification for this number"
    },
    "confidence_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 confidence in the classification"
    },
    "verified_business": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a known verified business number"
    },
    "business_name": {
      "type": "string",
      "description": "Verified business name if applicable"
    },
    "caller_id_label": {
      "type": "string",
      "description": "Published caller-ID label (e.g. 'Vardin: Scam Likely')"
    }
  },
  "required": [
    "phone_number"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}