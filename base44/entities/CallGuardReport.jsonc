{
  "name": "CallGuardReport",
  "type": "object",
  "properties": {
    "call_id": {
      "type": "string",
      "description": "Unique call identifier from the Retell voice agent"
    },
    "user_id": {
      "type": "string",
      "description": "User ID of the Call Guard subscriber whose call was screened"
    },
    "screened_phone_number": {
      "type": "string",
      "description": "Normalized phone number (digits only) that was screened (the subscriber's number)"
    },
    "caller_phone_number": {
      "type": "string",
      "description": "Phone number of the incoming caller"
    },
    "caller_name": {
      "type": "string",
      "description": "Name the caller provided during screening"
    },
    "claimed_organization": {
      "type": "string",
      "description": "Organization the caller claimed to represent"
    },
    "reason_for_call": {
      "type": "string",
      "description": "Stated reason for the call"
    },
    "requested_action": {
      "type": "string",
      "description": "What the caller asked the recipient to do"
    },
    "sensitive_information_requested": {
      "type": "string",
      "description": "Sensitive info the caller asked for (SSN, passwords, OTPs, banking details, etc.)"
    },
    "payment_requested": {
      "type": "string",
      "description": "Whether the caller asked for payment and details"
    },
    "urgency_or_threats": {
      "type": "string",
      "description": "Any urgency tactics or threats used by the caller"
    },
    "remote_access_requested": {
      "type": "string",
      "description": "Whether the caller asked for remote device/computer access"
    },
    "summary": {
      "type": "string",
      "description": "Retell agent's summary of the call"
    },
    "transcript": {
      "type": "string",
      "description": "Full transcript of the screening conversation"
    },
    "vardin_verdict": {
      "type": "string",
      "enum": [
        "SAFE",
        "SUSPICIOUS",
        "SCAM"
      ],
      "default": "SUSPICIOUS",
      "description": "Vardin AI's final scam assessment"
    },
    "confidence_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 confidence in Vardin's verdict"
    },
    "vardin_explanation": {
      "type": "string",
      "description": "Vardin AI's concise explanation of the verdict"
    },
    "scam_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key scam indicators identified by Vardin's AI"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Vardin's AI assessment was generated"
    }
  },
  "required": [
    "call_id",
    "summary"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}